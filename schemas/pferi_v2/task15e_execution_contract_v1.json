  },
  "optimizer": {
    "implementation": "scipy.optimize.minimize L-BFGS-B",
    "intercept_penalized": false,
    "maximum_iterations": 2000,
    "gradient_tolerance": 1e-8,
    "probability_clip": [1e-12, 0.999999999999]
  },
  "restricted_gam": {
    "continuous_basis": "quadratic B-spline",
    "degree": 2,
    "interior_knots": "one fold-training median on the standardized continuous feature",
    "boundary_knots": "fold-training minimum and maximum",
    "maximum_basis_dimension_per_continuous_term": 4,
    "categorical_terms": "unchanged frozen one-hot columns",
    "missing_indicators": "unchanged frozen explicit indicators",
