    "P3": {"family": "l2_logistic", "feature_blocks": ["descriptor", "independent_quality"]},
    "P4": {"family": "l2_logistic", "feature_blocks": ["pair_evidence"]},
    "P5": {"family": "l2_logistic", "feature_blocks": ["descriptor", "independent_quality", "pair_evidence"]},
