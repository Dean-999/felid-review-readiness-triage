    "S2": {"family": "restricted_penalized_logistic_gam", "feature_blocks": ["descriptor", "independent_quality", "pair_evidence"]}
  },
  "nested_validation": {
    "outer_folds": 5,
    "inner_folds": 4,
    "split_unit": "endpoint-connected component",
    "lambda_grid": [0.01, 0.03, 0.1, 0.3, 1.0, 3.0, 10.0, 30.0, 100.0],
    "selection_score": "Hajek-normalized full-IPW Brier on each inner validation fold",
