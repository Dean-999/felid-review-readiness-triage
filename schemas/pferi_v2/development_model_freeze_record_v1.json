{
  "schema_version": "pferi_v2_development_model_freeze_record_schema_v1",
  "purpose": "Define the minimum auditable fields and authorization semantics for the Task15H development-model freeze.",
  "authorization_rule": {
    "calibration_may_open_only_if": [
      "record_validation_status is PASS",
      "qualification_status is QUALIFIED",
      "development_model_frozen is true",
      "active_control_model_id is P3",
      "full_model_id is P5",
      "calibration_authorized is true"
    ],
    "validated_nonqualification_record_authorizes_calibration": false,
    "missing_or_unresolved_qualification_gate_counts_as_pass": false,
    "post_result_fallback_creation_is_prohibited": true
  },
  "required_top_level_fields": [
    "record_version",
    "status",
    "record_validation_status",
    "qualification_status",
    "development_model_frozen",
    "calibration_authorized",
    "source_evidence",
    "qualification_before_performance",
    "candidate_dispositions",
    "binding_decision",
    "locked_stages",
    "prohibited_actions",
    "next_authorized_action"
  ],
  "permitted_record_validation_status": [
    "PASS",
    "FAIL"
  ],
  "permitted_qualification_status": [
    "QUALIFIED",
    "NOT_QUALIFIED"
  ],
  "required_qualification_rules": [
    "zero_endpoint_leakage_across_folds",
    "zero_locked_stage_input_access",
    "fold_train_only_preprocessing",
    "finite_probabilities_in_unit_interval",
    "stable_regularization_or_shape_selection",
    "acceptable_calibration_intercept_and_slope",
    "complexity_budget_respected",
    "P3_and_P5_differ_only_by_pair_evidence"
  ],
  "rule_status_values": [
    "PASS",
    "FAIL",
    "UNRESOLVED"
  ],
  "candidate_role_constraints": {
    "confirmation_eligible_model_ids": [
      "P3",
      "P5"
    ],
    "P3_role": "active_control",
    "P5_role": "full_primary",
    "all_other_registered_models_must_remain_confirmation_ineligible": true,
    "P3_is_not_an_automatic_fallback_final_model": true
  },
  "claim_boundary": "A record may validate correctly while documenting that no development model qualified. Such a record preserves the lock on calibration and both confirmation stages."
}
